{
  "name": "nirapod",
  "version": "0.1.0",
  "private": true,
  "description": "Nirapod — Your Health, Our Priority. Bilingual (Bangla + English) mobile-first health PWA for Bangladesh.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "build:data": "tsx scripts/build-data.ts",
    "fetch:data": "tsx scripts/fetch-data.ts",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "mcp": "tsx --tsconfig ./tsconfig.json mcp/stdio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tesseract.js-data/ben": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^13.2.0",
    "dexie": "^4.4.7",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
