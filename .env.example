# Server-only. Never expose these to the client (no NEXT_PUBLIC_ prefix).
# Used by app/api/handwriting (reading handwritten prescriptions) and app/api/explain (plain-language rephrasing).
# All are OPTIONAL: without them the app still works — medicine names are typed with autocomplete from the local
# medicine database or found on the phone from a printed prescription, and explanations use the built-in template.
# A provider is used only when BOTH its key and its model are set; no model name is hard-coded.

# "anthropic" or "gemini": which one to use when both are set up. Falls back to whichever is configured.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini (Google AI Studio). Free tier: Google may use submitted content to improve its products;
# use a paid project for real patient data.
GEMINI_API_KEY=
GEMINI_MODEL=
